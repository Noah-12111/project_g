# Sao chép file này thành .env. KHÔNG đưa khóa thật lên GitHub.
PORT=3000

# Mặc định dùng Google Gemini API từ Google AI Studio.
AI_PROVIDER=gemini
GEMINI_API_KEY=PASTE_YOUR_NEW_GOOGLE_AI_STUDIO_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash

# Tuỳ chọn: nếu muốn quay lại dùng OpenClaw Gateway, đổi AI_PROVIDER=openclaw
OPENCLAW_API_URL=http://127.0.0.1:18789/v1/chat/completions
OPENCLAW_GATEWAY_TOKEN=PUT_YOUR_OPENCLAW_GATEWAY_TOKEN_HERE
OPENCLAW_MODEL=openclaw/default

# Tuỳ chọn: API tương thích OpenAI
AI_BASE_URL=https://YOUR_AI_PROVIDER/v1
AI_API_KEY=PUT_YOUR_API_KEY_HERE
AI_MODEL=YOUR_MODEL_ID
